// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("agent") // admin | manager | agent
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdLeads    Lead[]        @relation("CreatedLeads")
  assignedLeads   Lead[]        @relation("AssignedLeads")
  leadActivities  LeadActivity[]
  dailyReports    DailyReport[]
  appointments    Appointment[] @relation("AppointmentEmployee")
  orders          Order[]       @relation("OrderEmployee")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  type      String   @default("prospect") // prospect | client | partner
  status    String   @default("active") // active | inactive | archived
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String?
  company       String?
  source        String   @default("website") // website | referral | campaign | other
  status        String   @default("new") // new | contacted | callback | interested | ordered | lost
  productId     String?
  value         String?  // estimated value
  notes         String?
  nextFollowUp  DateTime? // date de prochain rappel
  createdById   String?  // employé qui a créé le lead
  assignedToId  String?  // employé assigné au lead
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy    User?         @relation("CreatedLeads", fields: [createdById], references: [id])
  assignedTo   User?         @relation("AssignedLeads", fields: [assignedToId], references: [id])
  activities   LeadActivity[]
  appointments Appointment[]
  orders       Order[]
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?  // employé qui a fait l'action
  type      String   // status_change | note | call | email | meeting | assignment
  content   String   // description de l'action
  oldValue  String?  // ancienne valeur (ex: ancien statut)
  newValue  String?  // nouvelle valeur (ex: nouveau statut)
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
}

model Appointment {
  id          String   @id @default(cuid())
  leadId      String   // lead associé au rendez-vous
  date        DateTime // date du rendez-vous
  time        String?  // heure du rendez-vous
  location    String?  // lieu du rendez-vous
  contactName String?  // nom du contact
  company     String?  // société
  notes       String?  // notes
  employeeId  String?  // employé qui a pris le rendez-vous
  status      String   @default("planned") // planned | completed | cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employee User? @relation("AppointmentEmployee", fields: [employeeId], references: [id])
}

model Order {
  id              String   @id @default(cuid())
  leadId          String   // lead associé à la commande
  contactName     String   // nom de la personne
  company         String?  // société
  products        String   // produits commandés
  quantity        Int      @default(1) // nombre de produits
  packagePrice    String?  // prix du package commandé
  deliveryDate    DateTime? // date de livraison
  status          String   @default("in_progress") // in_progress | delivered
  employeeId      String?  // nom de l'employé
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employee User? @relation("OrderEmployee", fields: [employeeId], references: [id])
}

model DailyReport {
  id        String   @id @default(cuid())
  userId    String   // employé qui rédige le rapport
  date      DateTime // date du rapport
  content   String   // contenu du rapport
  leadsCount Int     @default(0) // nombre de leads traités
  callsCount Int     @default(0) // nombre d'appels
  meetingsCount Int  @default(0) // nombre de rendez-vous
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date]) // un seul rapport par jour par employé
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  subject   String
  message   String
  productId String?
  status    String   @default("new") // new | in_progress | treated | archived
  stage     String   @default("received") // received | qualified | meeting | client (funnel)
  tags      String?  // comma-separated
  notes     String?  // internal notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id                  String   @id @default("singleton")
  // Général
  siteName            String   @default("HMC")
  siteFullName        String   @default("Horizon Management Consulting")
  tagline             String   @default("Votre partenaire en conseil et management des entreprises")
  email               String   @default("contact@hmc-consulting.pro")
  phone               String   @default("+221 77 455 11 36")
  partner             String   @default("Cheikh Lam")
  partnerRole         String   @default("Partner")
  // SEO
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String?
  ogImage             String?
  // Notifications
  notifyEmail         String?
  notifyOnNewMessage  Boolean  @default(true)
  notifyDailyDigest   Boolean  @default(false)
  notifyWeeklyDigest  Boolean  @default(true)
  // Réseaux sociaux
  linkedin            String?
  twitter             String?
  facebook            String?
  instagram           String?
  // SMTP (email)
  smtpHost            String?
  smtpPort            String?
  smtpUser            String?
  smtpPass            String?
  smtpFrom            String?
  // Auth
  adminPassword       String?
  // Auto-reply
  autoReplyEnabled    Boolean  @default(true)

  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // "new_message" | "system" | ...
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  type      String   // auto_reply | notification | reply
  status    String   @default("logged") // logged | sent | failed
  messageId String?  // related ContactMessage id
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String
  role      String
  content   String
  image     String
  project   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String
  image       String
  speciality  String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}